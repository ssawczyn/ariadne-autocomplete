{
	"name": "ariadne-autocomplete",
	"version": "0.1.2",
	"description": "Screen reader and keyboard accessibility for wikilink and other suggestion popups.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
	},
